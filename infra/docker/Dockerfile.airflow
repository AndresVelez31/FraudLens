# Airflow 2.9 con Java y los mismos jars/librerías: las tareas ejecutan los jobs de batch/ dentro del worker (LocalExecutor).
FROM apache/airflow:2.9.2-python3.11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl procps \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 TZ=UTC
USER airflow
COPY infra/docker/requirements.txt /tmp/requirements.txt
# fastapi/uvicorn no hacen falta en Airflow y pueden chocar con sus restricciones
RUN grep -v -E "^(fastapi|uvicorn|boto3)" /tmp/requirements.txt > /tmp/req-airflow.txt && pip install --no-cache-dir -r /tmp/req-airflow.txt
USER root
RUN set -eux; M=https://repo1.maven.org/maven2; J=$(python -c "import pyspark,os;print(os.path.join(os.path.dirname(pyspark.__file__),'jars'))"); \
    for f in \
      io/delta/delta-spark_2.12/3.1.0/delta-spark_2.12-3.1.0.jar \
      io/delta/delta-storage/3.1.0/delta-storage-3.1.0.jar \
      org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar \
      com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar \
      org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar ; do \
        curl -fsSL --retry 12 --retry-delay 15 --retry-all-errors -o "$J/$(basename $f)" "$M/$f"; done; sleep 1
USER airflow
ENV FRAUDLENS_HOME=/opt/fraudlens PYTHONPATH=/opt/fraudlens
