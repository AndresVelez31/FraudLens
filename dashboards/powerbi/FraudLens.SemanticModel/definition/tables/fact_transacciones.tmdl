table fact_transacciones
	lineageTag: 36233746-1d39-43b8-85bf-23b6c80d09a6

	measure Transacciones = COUNTROWS(fact_transacciones)
		formatString: 0
		lineageTag: a79390c7-1bdd-4d1a-9760-b374ea3c1566

	measure Sospechosas = CALCULATE([Transacciones], fact_transacciones[es_sospechosa] = TRUE())
		formatString: 0
		lineageTag: f921a437-f852-4e98-ad79-a065519c80ca

	measure '% fraude (transacciones)' = DIVIDE([Sospechosas], [Transacciones])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: aaaa9f0c-d68c-410c-8ddf-8e4a17f1d580

	measure 'Monto sospechoso' = CALCULATE(SUM(fact_transacciones[monto]), fact_transacciones[es_sospechosa] = TRUE())
		lineageTag: 5491e09d-8242-4c5b-aeeb-6ea7f160330e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% fraude (monto)' = DIVIDE([Monto sospechoso], SUM(fact_transacciones[monto]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7c75d1e4-d2de-4d98-b266-ee450ff7434b

	/// P6: monto sospechoso solo para las 10 regiones con más monto sospechoso (en empate pueden aparecer más de 10)
	measure 'Monto sospechoso (top 10)' = IF( [Monto sospechoso] > 0 && RANKX( ALL( fact_transacciones[region] ), [Monto sospechoso], , DESC ) <= 10, [Monto sospechoso] )
		formatString: #,0
		lineageTag: 582b466b-9b03-4567-b5dc-e89d75273ff4

	/// P7: transacciones con fraude confirmado (etiqueta de Vesta; en un banco, contracargos)
	measure 'Fraudes reales' = CALCULATE([Transacciones], fact_transacciones[es_fraude_real] = TRUE())
		formatString: #,0
		lineageTag: 12209412-1a64-4fd4-bdd4-9cbe8e777247

	measure '% fraude real' = DIVIDE([Fraudes reales], CALCULATE([Transacciones], NOT ISBLANK(fact_transacciones[es_fraude_real])))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 92c42ec3-3561-4392-bf5f-5a794f610fe2

	/// P7: alertas que sí eran fraude (verdaderos positivos)
	measure Aciertos = CALCULATE([Transacciones], fact_transacciones[es_sospechosa] = TRUE(), fact_transacciones[es_fraude_real] = TRUE())
		formatString: #,0
		lineageTag: 66a5e9ed-eb28-453f-88b1-99926cd9250c

	/// P7: alertas sobre pagos legítimos
	measure 'Falsos positivos' = CALCULATE([Transacciones], fact_transacciones[es_sospechosa] = TRUE(), fact_transacciones[es_fraude_real] = FALSE())
		formatString: #,0
		lineageTag: 14648158-19a2-4e76-8d03-c56f978fa751

	/// P7: de cada 100 alertas (con etiqueta), cuántas eran fraude
	measure Precisión = DIVIDE([Aciertos], [Aciertos] + [Falsos positivos])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 04a565b2-f60f-407c-8ce4-f1779eefd355

	/// P7: de cada 100 fraudes reales, cuántos se marcaron
	measure Cobertura = DIVIDE([Aciertos], [Fraudes reales])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 17074606-2306-492c-a1de-eb8b218f0d64

	/// P7: falsos positivos por cada 1.000 pagos legítimos
	measure 'FP por 1.000 legítimas' = DIVIDE(1000 * [Falsos positivos], CALCULATE([Transacciones], fact_transacciones[es_fraude_real] = FALSE()))
		formatString: 0.0
		lineageTag: 297d23e5-9ddd-451a-a94a-2bb2f3fd189a

