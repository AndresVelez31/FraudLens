table fact_alertas
	lineageTag: 80de0b42-d159-46e7-99bf-23ebe18fbd20

	measure Alertas = COUNTROWS(fact_alertas)
		formatString: 0
		lineageTag: ceb1043f-838d-41d3-8de2-cb41db1a3ccf

	measure 'Latencia promedio (s)' = AVERAGE(fact_alertas[latencia_s])
		formatString: 0.00
		lineageTag: 179173c5-bcf8-4f83-bb36-d2da9d018fc6

	measure 'Latencia P95 (s)' = PERCENTILE.INC(fact_alertas[latencia_s], 0.95)
		formatString: 0.00
		lineageTag: 9949e84a-4270-499e-ab01-0ee0825e73c7

	measure 'Alertas con etiqueta' = CALCULATE([Alertas], NOT ISBLANK(fact_alertas[es_fraude_real]))
		formatString: #,0
		lineageTag: f452caea-e188-4f66-bd1d-d8d65683e843

	/// P7: precisión por regla (R2, R3, R4; R1 marca ventanas y no transacciones)
	measure 'Precisión de la regla' = DIVIDE(CALCULATE([Alertas], fact_alertas[es_fraude_real] = TRUE()), [Alertas con etiqueta])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 76b05743-81be-4734-8f84-ce247e0613f6

	measure 'Puntaje promedio' = AVERAGE(fact_alertas[puntaje])
		formatString: 0.000
		lineageTag: 9240d8e0-ab82-42e4-8b27-4c854478bd25

