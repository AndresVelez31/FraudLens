unded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="raw" target="airflow1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="375"/><mxPoint x="290" y="723"/></Array></mxGeometry></mxCell><mxCell id="f5" value="~50 pagos/s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="replayer" target="kafka"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="kafka" target="spark"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f7" value="Bronze + Silver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.331;" edge="1" parent="1" source="spark" target="lake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f8b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="raw" target="bronze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bronze" target="silver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="silver" target="gold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f10" value="28.154 alertas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#C7131F;fontColor=#C7131F;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="spark" target="ddb"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="822" y="514"/><mxPoint x="822" y="978"/></Array></mxGeometry></mxCell><mxCell id="f11" value="Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#C7131F;fontColor=#C7131F;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="ddb" target="lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#C7131F;fontColor=#C7131F;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="lambda" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f13" value="correo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#C7131F;fontColor=#C7131F;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="sns" target="correo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#C7131F;fontColor=#C7131F;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="lambda" target="sqs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f15" value="GET /alertas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="users" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f16" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="api" target="ddb"><mxGeometry x="-0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="495"/><mxPoint x="1100" y="964"/></Array></mxGeometry></mxCell><mxCell id="f17" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="postgres" target="airflow1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f18" value="catálogos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=0;entryX=0;entryY=0.601;" edge="1" parent="1" source="airflow1" target="lake"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="422" y="652"/></Array></mxGeometry></mxCell><mxCell id="f19" value="Silver → Gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.751;" edge="1" parent="1" source="airflow2" target="lake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.751;entryX=0;entryY=0.5;" edge="1" parent="1" source="lake" target="glue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="glue" target="athena"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f22" value="Import" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="athena" target="powerbi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="paso1" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="117" y="124" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso2" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="111" y="456" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso3" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="641" y="456" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="721" y="440" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="896" y="938" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1165" y="460" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso7" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="376" y="702" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso8" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="641" y="702" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso9" value="9" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1173" y="690" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso10" value="10" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1436" y="696" width="26" height="26" as="geometry"/></mxCell><mxCell id="paso11" value="11" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="66" y="938" width="26" height="26" as="geometry"/></mxCell><mxCell id="panel" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cómo fluye un pago&lt;/b&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Los 590.540 pagos de IEEE-CIS se preparan (partición 80/20 por tiempo) y se suben a &lt;b&gt;Amazon S3&lt;/b&gt;; la etiqueta de fraude va en un archivo aparte.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;2.&lt;/b&gt; El &lt;b&gt;replayer&lt;/b&gt; lee los eventos de S3 y los publica en &lt;b&gt;Kafka&lt;/b&gt; en su orden real, ~50 pagos/s, con clave id_cliente.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;Spark Structured Streaming&lt;/b&gt; lee micro-lotes de 5 s: guarda el crudo en Bronze, manda el JSON ilegible a la DLQ y lo inválido a cuarentena, y hace MERGE a Silver sin duplicados.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;4.&lt;/b&gt; En el mismo lote corren &lt;b&gt;R2&lt;/b&gt; (dispositivo nuevo, perfil de Gold), &lt;b&gt;R3&lt;/b&gt; (lista de riesgo) y &lt;b&gt;R4&lt;/b&gt; (modelo LightGBM leído de S3 + historia del cliente en Silver). Las alertas van a &lt;b&gt;DynamoDB&lt;/b&gt; con escritura condicional: 28.154, ninguna repetida.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;5.&lt;/b&gt; &lt;b&gt;DynamoDB Streams&lt;/b&gt; invoca a &lt;b&gt;Lambda&lt;/b&gt;, que junta hasta 5 min de alertas y manda un resumen por &lt;b&gt;SNS&lt;/b&gt;. Si falla, reintenta 2 veces y deja el lote en &lt;b&gt;SQS&lt;/b&gt;; sus logs quedan en CloudWatch.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;6.&lt;/b&gt; Los analistas consultan cualquier alerta en la &lt;b&gt;API&lt;/b&gt; (por regla, cliente o fecha), que lee DynamoDB.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;7.&lt;/b&gt; &lt;b&gt;Airflow&lt;/b&gt; carga a diario los catálogos de PostgreSQL y la lista de riesgo de S3 a Bronze y Silver.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;8.&lt;/b&gt; Cada 10 min, Airflow pasa de Silver a &lt;b&gt;Gold&lt;/b&gt; (estrella, SCD2, hora de Colombia), cruza la etiqueta de fraude real y revisa la calidad.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;9.&lt;/b&gt; &lt;b&gt;AWS Glue&lt;/b&gt; guarda los metadatos de Gold y &lt;b&gt;Amazon Athena&lt;/b&gt; lo consulta con SQL.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;10.&lt;/b&gt; &lt;b&gt;Power BI&lt;/b&gt; importa P4–P7 desde Athena, incluida la precisión contra el fraude real.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;11.&lt;/b&gt; &lt;b&gt;EventBridge Scheduler&lt;/b&gt; apaga las EC2 a las 23:00, &lt;b&gt;Systems Manager&lt;/b&gt; las opera sin SSH e &lt;b&gt;IAM&lt;/b&gt; da a cada pieza solo los permisos que necesita.&lt;/p&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="72" width="345" height="830" as="geometry"/></mxCell><mxCell id="ley" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;— Flujo de datos&lt;br&gt;&lt;font color=&quot;#C7131F&quot;&gt;— Camino de las alertas&lt;/font&gt;&lt;br&gt;- - Evento o lectura&lt;br&gt;Ícono naranja: contenedor Docker en una EC2&lt;br&gt;Ícono de color: servicio administrado de AWS&lt;br&gt;R1 apagada (REGLAS_ACTIVAS=R2,R3,R4)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="914" width="345" height="176" as="geometry"/></mxCell><mxCell id="kpis" value="" style="rounded=1;arcSize=4;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="1104" width="1945" height="108" as="geometry"/></mxCell><mxCell id="kpit" value="&lt;b&gt;Cifras medidas en la carga real&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A626E&quot;&gt;Athena sobre Gold · partición de prueba = 20 % final, no usada para calibrar ni entrenar&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="46" y="1114" width="300" height="88" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;590.540&lt;/font&gt;&lt;/b&gt;&lt;br&gt;pagos reales procesados&lt;br&gt;0 duplicados en Silver" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="1116" width="256" height="84" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;20,9 %&lt;/font&gt;&lt;/b&gt;&lt;br&gt;precisión: alertas que eran fraude&lt;br&gt;(reglas del E1: 6,5 %)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="1116" width="256" height="84" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;23,7 %&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cobertura: fraudes detectados&lt;br&gt;(reglas del E1: 3,3 %)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="1116" width="256" height="84" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;32&lt;/font&gt;&lt;/b&gt;&lt;br&gt;falsos positivos por cada&lt;br&gt;1.000 pagos legítimos" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1170" y="1116" width="256" height="84" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;202 s&lt;/font&gt;&lt;/b&gt;&lt;br&gt;latencia P95 emisión → alerta&lt;br&gt;cola 45 s · proceso 68 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1440" y="1116" width="256" height="84" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;USD 1,20&lt;/font&gt;&lt;/b&gt;&lt;br&gt;costo EC2 de la carga&lt;br&gt;2 máquinas · 6 h" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710" y="1116" width="256" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>