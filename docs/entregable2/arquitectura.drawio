source="postgres" target="airflow1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a13" value="catálogos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="airflow1" target="silver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="557" y="584"/><mxPoint x="962" y="584"/><mxPoint x="962" y="475"/></Array></mxGeometry></mxCell><mxCell id="a14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="airflow2" target="gold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a15" value="registro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gold" target="glue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="glue" target="athena"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="athena" target="powerbi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a18" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.2;" edge="1" parent="1" source="api" target="ddb"><mxGeometry x="-0.85" relative="1" as="geometry"><Array as="points"><mxPoint x="1228" y="445"/><mxPoint x="1228" y="871"/></Array></mxGeometry></mxCell><mxCell id="a19" value="GET /alertas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#232F3E;fontColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="users" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_34_210" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="34" y="210" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_248_390" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="248" y="390" width="26" height="26" as="geometry"/></mxCell><mxCell id="p3_778_390" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="778" y="390" width="26" height="26" as="geometry"/></mxCell><mxCell id="p4_1043_848" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1043" y="848" width="26" height="26" as="geometry"/></mxCell><mxCell id="p5_1236_846" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1236" y="846" width="26" height="26" as="geometry"/></mxCell><mxCell id="p6_513_634" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="513" y="634" width="26" height="26" as="geometry"/></mxCell><mxCell id="p7_778_634" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="778" y="634" width="26" height="26" as="geometry"/></mxCell><mxCell id="p8_1352_628" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1352" y="628" width="26" height="26" as="geometry"/></mxCell><mxCell id="p9_1272_410" value="9" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1272" y="410" width="26" height="26" as="geometry"/></mxCell><mxCell id="p10_186_872" value="10" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="186" y="872" width="26" height="26" as="geometry"/></mxCell><mxCell id="panel" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cómo fluye un pago&lt;/b&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Los 590.540 pagos reales de IEEE-CIS se preparan (partición 80/20 por tiempo) y se suben a &lt;b&gt;Amazon S3&lt;/b&gt;; la etiqueta de fraude va aparte.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;2.&lt;/b&gt; El replayer los publica en &lt;b&gt;Kafka&lt;/b&gt; en su orden real, ~50 pagos/s, con clave id_cliente.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;Spark&lt;/b&gt; lee micro-lotes de 5 s: Bronze crudo, JSON ilegible a la DLQ, cuarentena por calidad y MERGE a Silver sin duplicados.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;4.&lt;/b&gt; R2, R3 y R4 (LightGBM, umbral 0,155) generan alertas en &lt;b&gt;DynamoDB&lt;/b&gt; con escritura condicional: 28.154 alertas, ninguna repetida.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;5.&lt;/b&gt; &lt;b&gt;DynamoDB Streams&lt;/b&gt; invoca a &lt;b&gt;Lambda&lt;/b&gt;, que junta hasta 5 min de alertas y manda un resumen por &lt;b&gt;SNS&lt;/b&gt;; si falla, el lote queda en &lt;b&gt;SQS&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;6.&lt;/b&gt; &lt;b&gt;Airflow&lt;/b&gt; carga a diario los catálogos de PostgreSQL y la lista de riesgo a Bronze y Silver.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;7.&lt;/b&gt; Cada 10 min, Airflow construye Gold (estrella, SCD2, fraude real), revisa calidad y registra las tablas en &lt;b&gt;Glue&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;8.&lt;/b&gt; &lt;b&gt;Athena&lt;/b&gt; consulta Gold y &lt;b&gt;Power BI&lt;/b&gt; importa P4–P7, incluida la precisión contra el fraude real.&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;9.&lt;/b&gt; Los analistas consultan las alertas por la API (filtro por regla, cliente y fecha).&lt;/p&gt;&lt;p style=&quot;margin:7px 0 0 0&quot;&gt;&lt;b&gt;10.&lt;/b&gt; &lt;b&gt;EventBridge Scheduler&lt;/b&gt; apaga las EC2 a las 23:00, &lt;b&gt;Systems Manager&lt;/b&gt; las opera sin SSH e &lt;b&gt;IAM&lt;/b&gt; da roles de mínimo privilegio.&lt;/p&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1640" y="82" width="330" height="640" as="geometry"/></mxCell><mxCell id="ley" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;— Flujo de datos&lt;br&gt;&lt;font color=&quot;#C7131F&quot;&gt;— Camino de las alertas&lt;/font&gt;&lt;br&gt;- - Evento o consulta&lt;br&gt;Ícono naranja: contenedor Docker en EC2&lt;br&gt;Ícono de color: servicio administrado de AWS&lt;br&gt;R1 apagada: REGLAS_ACTIVAS=R2,R3,R4" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1640" y="740" width="330" height="168" as="geometry"/></mxCell><mxCell id="kpis" value="" style="rounded=1;arcSize=4;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="20" y="1024" width="1950" height="108" as="geometry"/></mxCell><mxCell id="kpit" value="&lt;b&gt;Cifras medidas en la carga real&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5A626E&quot;&gt;Athena sobre Gold · partición de prueba = 20 % final, no usada para calibrar ni entrenar&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="36" y="1034" width="300" height="88" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;590.540&lt;/font&gt;&lt;/b&gt;&lt;br&gt;pagos reales procesados&lt;br&gt;0 duplicados en Silver" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="1036" width="252" height="84" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;20,9 %&lt;/font&gt;&lt;/b&gt;&lt;br&gt;precisión: alertas que eran fraude&lt;br&gt;(reglas del E1: 6,5 %)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="618" y="1036" width="252" height="84" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;23,7 %&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cobertura: fraudes detectados&lt;br&gt;(reglas del E1: 3,3 %)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="886" y="1036" width="252" height="84" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;32&lt;/font&gt;&lt;/b&gt;&lt;br&gt;falsos positivos por cada&lt;br&gt;1.000 pagos legítimos" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1154" y="1036" width="252" height="84" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;202 s&lt;/font&gt;&lt;/b&gt;&lt;br&gt;latencia P95 emisión → alerta&lt;br&gt;cola 45 s · proceso 68 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1422" y="1036" width="252" height="84" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#147EBA&quot;&gt;USD 1,20&lt;/font&gt;&lt;/b&gt;&lt;br&gt;costo EC2 de la carga&lt;br&gt;2 máquinas · 6 h" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontSize=12;fontColor=#1B1F24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1690" y="1036" width="252" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>