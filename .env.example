# Copiar a .env y completar. Nunca subir .env al repositorio.
# Sirve igual en AWS y en local: en local, compose.local.yml reemplaza S3 y DynamoDB por MinIO y DynamoDB Local.

# --- Obligatorios (generar con: openssl rand -hex 24) ---
POSTGRES_PASSWORD=
PII_HMAC_KEY=

# --- AWS (proyecto FraudLens, plan gratuito, us-east-2) ---
AWS_REGION=us-east-2
S3_BUCKET=fraudlens-lake-216408407230
DYNAMODB_TABLE=alertas_fraude
SNS_TOPIC_ARN=arn:aws:sns:us-east-2:216408407230:alertas-fraude
# Como máximo un correo resumen de alertas cada N segundos (el primero sale de inmediato).
NOTIFICAR_CADA_SEGUNDOS=300
GLUE_DATABASE=fraudlens
ATHENA_WORKGROUP=fraudlens
# No se ponen llaves de AWS: en la EC2 las credenciales salen del rol fraudlens-ec2.

# --- Kafka y PostgreSQL (nombres de los contenedores; no cambian) ---
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_TOPIC=transacciones
KAFKA_DLQ_TOPIC=transacciones_dlq
POSTGRES_HOST=postgres
POSTGRES_DB=fraudlens
POSTGRES_USER=fraudlens

# --- Pipeline ---
RULE_VERSION=v1
N_CLIENTES=20000
N_COMERCIOS=300
SPARK_MASTER=local[2]
AIRFLOW_ADMIN_PASSWORD=

# --- Qué levanta `docker compose` en esta máquina (descomentar UNA opción) ---
# EC2-A (Kafka + streaming):
# COMPOSE_PROFILES=streaming
# EC2-B (Airflow + batch + API):
# COMPOSE_PROFILES=batch
# Local, todo en una máquina (en Windows el separador de COMPOSE_FILE es ";" en lugar de ":"):
# COMPOSE_FILE=docker-compose.yml:compose.local.yml
# COMPOSE_PROFILES=streaming,batch

# --- Solo local (compose.local.yml) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
