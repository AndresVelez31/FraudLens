# Copiar a .env y completar. Nunca subir .env al repositorio.
AWS_REGION=us-east-1
# En AWS: S3_BUCKET=fraudlens-lake-<sufijo>
DYNAMODB_TABLE=alertas_fraude
SNS_TOPIC_ARN=
GLUE_DATABASE=fraudlens
ATHENA_WORKGROUP=fraudlens

KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_TOPIC=transacciones
KAFKA_DLQ_TOPIC=transacciones_dlq

POSTGRES_HOST=postgres
POSTGRES_DB=fraudlens
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=

# Clave del HMAC-SHA-256 para seudonimizar datos personales (RNF-07)
PII_HMAC_KEY=

# --- Local con docker-compose (en AWS déjalos vacíos: ver README) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
DYNAMODB_ENDPOINT=http://dynamodb:8000
S3_BUCKET=fraudlens-lake
N_CLIENTES=20000
N_COMERCIOS=300
RULE_VERSION=v1
AIRFLOW_ADMIN_PASSWORD=
# Imagen de MinIO (minio/minio ya no está en Docker Hub)
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
